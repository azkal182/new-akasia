DATABASE_URL=postgresql://postgres@localhost:5432/new-akasia-v2?schema=public

NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=http://localhost:3000
AUTH_SECRET=replace-with-random-secret

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_STORAGE_BUCKET=akasia

# Upload Storage
# Keep "supabase" during rollout, then switch to "r2" for all new uploads.
STORAGE_PROVIDER=supabase
# Optional emergency fallback for failed R2 uploads.
STORAGE_FALLBACK_TO_SUPABASE=false

# Cloudflare R2 (required when STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
# Optional override, defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=akasia
# Public custom domain or r2.dev URL, without a trailing slash.
R2_PUBLIC_URL=https://files.example.com

# Storage Configuration
# New uploads use R2. Keep the Supabase variables above while legacy Supabase
# object URLs still need to support deletion.
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=akasia
R2_PUBLIC_URL=https://cdn.example.com

# WhatsApp API Configuration
WA_API_URL=https://wa-multi-session.example.com/api/v1
WA_SESSION_ID=replace-with-session-id
WA_API_KEY=replace-with-wa-api-key
WA_RECIPIENT=6281234567890
WA_APPROVAL_RECIPIENT=6281234567891

# External Integration API Client
INTEGRATION_API_BASE_URL=https://integration.example.com
INTEGRATION_API_KEY=replace-with-integration-api-key
INTEGRATION_DIVISION_ID=cmabc123division
INTEGRATION_API_TIMEOUT_MS=10000
